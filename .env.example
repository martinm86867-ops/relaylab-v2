# RelayLab needs no environment variables for local development.
# The mock LLM provider is keyless, so the AI-agent feature works out of the box.

# Server
# HOST=127.0.0.1
# PORT=3000

# Optional: require this token on spawn/delete/control requests.
# RELAYLAB_ADMIN_TOKEN=

# --- Managed LLM agents (all optional) ---
# Any OpenAI-compatible endpoint. For a local, keyless server (Ollama, LM Studio,
# llama.cpp, vLLM), point the base URL at localhost and leave the key empty.
# RELAYLAB_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RELAYLAB_LLM_API_KEY=
# RELAYLAB_LLM_MODEL=llama3.1

# OpenAI / DeepSeek (OpenAI-compatible)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
